# ===== Sitio =====
PUBLIC_URL=https://soporte.nibbletec.com
BRAND_NAME=Nibbletec

# ===== Técnicos =====
# Formato: usuario:Nombre visible:contraseña  (varios técnicos separados por comas)
# Recomendado: guarda un hash en lugar de la contraseña. Genéralo con:
#   docker compose run --rm assist node server.js hash-password "tu-contraseña"
TECH_USERS=dpochet:Daniel:scrypt.CAMBIAR.CAMBIAR

# Firma las cookies de los técnicos. Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# ===== Sesiones =====
# Minutos que dura el enlace si el cliente no lo abre
LINK_TTL_MIN=60
# Duración máxima de una sesión, en horas
SESSION_MAX_HOURS=8
# Número de proxies delante de la app (Traefik = 1)
TRUST_PROXY=1

# ===== STUN / TURN (coturn) =====
STUN_URLS=stun:turn.nibbletec.com:3478
TURN_URLS=turn:turn.nibbletec.com:3478?transport=udp,turn:turn.nibbletec.com:3478?transport=tcp
# Secreto compartido con coturn. Genera uno con: openssl rand -hex 32
TURN_SECRET=
TURN_REALM=turn.nibbletec.com
# IP pública del servidor donde corre coturn
TURN_EXTERNAL_IP=

# ===== Opcional: enviar cada evento del registro a otro sistema (n8n, Odoo...) =====
WEBHOOK_URL=
# Si se define, cada envío lleva la cabecera x-assist-signature (HMAC-SHA256 del cuerpo)
WEBHOOK_SECRET=
